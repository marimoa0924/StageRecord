# ============================================================
# StageRecord — Environment Variables Template
# ============================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in every value marked <REQUIRED>
# 3. NEVER commit .env.local — it is listed in .gitignore
# ============================================================

# ------------------------------------------------------------
# Database (Neon Postgres)
# One of these two variables must be set.
# Vercel Postgres integration sets POSTGRES_URL automatically.
# ------------------------------------------------------------
DATABASE_URL=<REQUIRED: postgresql://user:password@host/dbname?sslmode=require>
# POSTGRES_URL=<alternative provided by Vercel Postgres integration>

# ------------------------------------------------------------
# NextAuth v5 (Auth.js)
# AUTH_SECRET: generate with `npx auth secret` or
#              `openssl rand -base64 32`
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: from Google Cloud Console
#   OAuth 2.0 Credentials → Authorized redirect URIs must include:
#   https://<your-domain>/api/auth/callback/google
# ------------------------------------------------------------
AUTH_SECRET=<REQUIRED: minimum 32-character random string>
AUTH_GOOGLE_ID=<REQUIRED: xxxxxxxx.apps.googleusercontent.com>
AUTH_GOOGLE_SECRET=<REQUIRED: GOCSPX-xxxxxxxxxxxxxxxxxxxx>

# ------------------------------------------------------------
# Vercel Blob Storage
# Obtain from Vercel Dashboard → Storage → Blob → Token
# ------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=<REQUIRED: vercel_blob_rw_xxxxxxxxxxxxxxxx>

# ------------------------------------------------------------
# Application
# Used for CORS Allow-Origin and NextAuth redirect validation.
# No trailing slash.
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://stage-record.vercel.app

# ------------------------------------------------------------
# Owner Access Control
# The Google account email that has write (owner) privileges.
# ------------------------------------------------------------
OWNER_EMAIL=<REQUIRED: you@example.com>

# ------------------------------------------------------------
# Runtime (set automatically by Next.js / Vercel)
# Do NOT override in production.
# ------------------------------------------------------------
# NODE_ENV=production
